node_modules/
*.log
.DS_Store

# dsh-loom runtime state (plugin-managed, never commit or pack)
.esr/
.pi-esr-memory/
.pi-loom/

# packed publish artifacts (never commit)
*.tgz

# generated typecheck overlay (client/typecheck.mjs)
client/tsconfig.build.json

# package manager is pnpm (see "packageManager" in package.json); pnpm-lock.yaml is committed.
# keep guarding against accidental npm usage
package-lock.json

# generated DSH skills from `dsh-engram skill export` (runtime state)
.dsh/
eval/g6/runs/**/ws/

# G6 experiment home (DSH_HOME for the two arms; dsh state, never commit)
.g6/

# G6 workspaces: the arms' own files, reproducible by re-running the matrix
eval/g6/runs/*/runs/

# G6 rounds compiled from a secret: key.json IS the answer key for that round
eval/g6/local/
